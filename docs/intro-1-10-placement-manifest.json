  "pois": [
    {
      "id": "in_courier_satchel",
      "name": "Paige’s Spilled Satchel",
      "at": [
        -471,
        -315
      ],
      "note": "A waxed courier bag lies under the broken axle. The envelopes are clean. Paige used her own coat to keep the rain off them.",
      "kind": "story",
      "region": "tf_reach",
      "noMarker": true
    },
    {
      "id": "in_della_well",
      "name": "The Old Well",
      "at": [
        -282,
        -395
      ],
      "note": "A sewing tin rests on the dry stone rim. Della has tied a ribbon to the handle so she can find it in the mist.",
      "kind": "place",
      "region": "vr_hollow",
      "noMarker": true
    },
    {
      "id": "in_bridge_brace",
      "name": "The Crossing Brace",
      "at": [
        -231,
        -161
      ],
      "note": "Ada’s marks run straight along the timber. Two new boards and sound rope will hold the cartway. A crooked fee notice has been nailed over her measurement.",
      "kind": "place",
      "region": "rillbank",
      "noMarker": true
    },
    {
      "id": "in_cart_shed",
      "name": "Ada’s Cart Shed",
      "at": [
        -259,
        -121
      ],
      "note": "Wheel rims, pegged joints and a kettle kept just off the fire. Each unfinished cart carries its owner’s name.",
      "kind": "place",
      "region": "rillbank",
      "noMarker": true
    },
    {
      "id": "in_toll_cart",
      "name": "The Abandoned Toll Cart",
      "at": [
        -274,
        -154
      ],
      "note": "A collector’s cart stands in the trees. The driver’s original bill is wrapped around a loaf to keep it dry. The loaf has been eaten.",
      "kind": "story",
      "region": "rillbank",
      "noMarker": true
    },
    {
      "id": "in_reed_marker",
      "name": "The Ferry Depth Marker",
      "at": [
        -551,
        -100
      ],
      "note": "The scratched red line marks a safe trickle for the bank channel. Nessa’s instruction is plain. Keep the bank shallow and the ferry channel full.",
      "kind": "place",
      "region": "mirefen",
      "noMarker": true
    },
    {
      "id": "in_ferry_lock",
      "name": "The Ferry Sluice",
      "at": [
        -551,
        -94
      ],
      "note": "Two handles control the shallow bank cut and the ferry channel. The boards are worn by generations of boatmen.",
      "kind": "place",
      "region": "mirefen",
      "noMarker": true
    },
    {
      "id": "in_reed_cache",
      "name": "The Collector’s Reed Cache",
      "at": [
        -590,
        -112
      ],
      "note": "A waterproof case has been wedged beneath the fallen willow. Several settled accounts have been copied onto a fresh list of debts.",
      "kind": "story",
      "region": "mirefen",
      "noMarker": true
    },
    {
      "id": "in_lamplighters",
      "name": "Lamplighter’s Rest",
      "at": [
        -343,
        -101
      ],
      "note": "A shared watch fire keeps the crossing road and ferry ridge connected. Sella’s spare blankets are folded by the kettle.",
      "kind": "camp",
      "region": "rillbank",
      "noMarker": true
    },
    {
      "id": "in_mine_camp",
      "name": "The Miners’ Rest",
      "at": [
        -275,
        -96
      ],
      "note": "Edda has kept every shift tally, including the days the miners were told they had not worked.",
      "kind": "camp",
      "region": "rillbank",
      "noMarker": true
    },
    {
      "id": "in_lime_cut",
      "name": "The Old Lime Cut",
      "at": [
        -288,
        -242
      ],
      "note": "A shallow quarry shelf leads toward Blackpick. The wider turns leave room to step out of a heavy swing.",
      "kind": "hunt",
      "region": "rillbank",
      "noMarker": true
    },
    {
      "id": "in_bailiff_desk",
      "name": "The Bailiff’s Desk",
      "at": [
