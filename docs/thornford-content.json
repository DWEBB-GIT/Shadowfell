  "quests": [
    {
      "id": "tf_lanterns",
      "name": "Where the Lanterns Went Out",
      "map": "new",
      "giver": "tf_rowan",
      "turnIn": "tf_rowan",
      "summary": "Follow the lantern road north, examine the fallen watch lantern and defeat three revenants. Return to Captain Rowan in Thornford.",
      "offer": "The watch carried lanterns up the north road last night. None came home. Find their fallen lantern by the cart and put three of those dead things to rest. Come back here when it is done.",
      "progress": "Follow the marked paths. The signposts will bring you back to Thornford.",
      "complete": "The lantern glass is cold. Rowan turns it over in his hands. 'They reached the old watch. Speak to Fen in Briarwood before you go after them.'",
      "objectives": [
        {
          "id": "lantern",
          "type": "examine",
          "target": "poi:tf_cairn",
          "label": "Examine the fallen lantern",
          "location": "tf_cairn"
        },
        {
          "id": "dead",
          "type": "kill",
          "target": "tf_revenant",
          "count": 3,
          "label": "Road revenants defeated",
          "location": "tf_cairn"
        }
      ],
      "reward": {
        "coins": 25,
        "xp": 260,
        "items": [
          {
            "item": "healing_draught",
            "count": 2
          }
        ]
      },
      "requires": [],
      "autoAccept": true
    },
    {
      "id": "tf_briar",
      "name": "The Way Through Briarwood",
      "map": "new",
      "giver": "tf_scout",
      "turnIn": "tf_scout",
      "summary": "Clear three Briarwood wolves and survey Wolf Hollow. The woodland path loops back to the watch road.",
      "offer": "The wolves have taken the hollow south of this camp. Clear three and look over the hollow. Its eastern path will put you back on the watch road, below the ruins.",
      "progress": "Follow the marked paths. The signposts will bring you back to Thornford.",
      "complete": "You have done the Reach a kindness. Here, take this for the road.",
      "objectives": [
        {
          "id": "wolves",
          "type": "kill",
          "target": "tf_wolf",
          "count": 3,
          "label": "Briarwood wolves defeated",
          "location": "tf_hollow"
        },
        {
          "id": "hollow",
          "type": "examine",
          "target": "poi:tf_hollow",
          "label": "Survey Wolf Hollow",
          "location": "tf_hollow"
        }
      ],
      "reward": {
        "coins": 20,
        "xp": 400,
        "items": [
          {
            "item": "tool_pack",
            "count": 1
          }
        ]
      },
      "requires": [
        "tf_lanterns"
      ]
    },
    {
      "id": "tf_bell",
      "name": "The Silent Watch",
      "map": "new",
      "giver": "tf_rowan",
      "turnIn": "tf_rowan",
      "summary": "Find the Old Watch Ruins, defeat the Bellkeeper and visit Dawnstone Shrine. Return to Captain Rowan.",
      "offer": "Fen has opened the western loop. Now take the road north to the broken watchtower. The Bellkeeper is still there, though no living hand rings that bell. End his watch, then climb to Dawnstone Shrine and tell me what you found.",
      "progress": "Follow the marked paths. The signposts will bring you back to Thornford.",
      "complete": "For the first time in days, birds call along the north road. Rowan sets a shield on the table. 'The Reach has a road again. And now it has a Warden.'",
      "objectives": [
        {
          "id": "ruins",
          "type": "examine",
          "target": "poi:tf_watch",
          "label": "Search the Old Watch Ruins",
          "location": "tf_watch"
        },
        {
          "id": "keeper",
          "type": "kill",
          "target": "tf_keeper",
          "count": 1,
          "label": "The Bellkeeper defeated",
          "location": "tf_watch"
        },
        {
          "id": "shrine",
          "type": "examine",
          "target": "poi:tf_shrine",
          "label": "Visit Dawnstone Shrine",
          "location": "tf_shrine"
        }
      ],
      "reward": {
        "coins": 40,
        "xp": 400,
        "items": [
          {
            "item": "iron_shield",
            "count": 1
          }
        ]
      },
      "requires": [
        "tf_briar"
      ],
      "setsFlag": "tf_reach_safe"
    },
    {
      "id": "tf_herbs",
      "name": "Something for the Road",
      "map": "new",
      "giver": "tf_elsie",
      "turnIn": "tf_elsie",
      "summary": "Gather three ditchbell flowers beside the Briarwood path and bring them to Elsie at the Lantern Inn.",
      "offer": "Blue ditchbell grows along the western woodland path. Bring me three sprigs. You need no training to pick those marked patches, and I will brew something useful for your pack.",
      "progress": "Follow the marked paths. The signposts will bring you back to Thornford.",
      "complete": "You have done the Reach a kindness. Here, take this for the road.",
      "objectives": [
        {
          "id": "herbs",
          "type": "collect",
          "target": "ditchbell",
          "count": 3,
          "label": "Ditchbell flowers",
          "location": "tf_camp"
        }
      ],
