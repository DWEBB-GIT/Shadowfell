  "dialogues": [
    {
      "id": "tf_rowan",
      "greetings": [
        {
          "text": "Welcome to Thornford, Warden. The north road needs a steady hand. Keep the lanterns on your left and you will find your way back."
        }
      ],
      "topics": [],
      "nodes": []
    },
    {
      "id": "tf_elsie",
      "greetings": [
        {
          "text": "A bed, a hot meal, and a little light in the windows. That is what I can offer. Set your home here before you take the woodland road."
        }
      ],
      "topics": [],
      "nodes": []
    },
    {
      "id": "tf_iren",
      "greetings": [
        {
          "text": "The forge is hot. I can mend what the woods have bitten and sell you something that bites back."
        }
      ],
      "topics": [],
      "nodes": []
    },
    {
      "id": "tf_scout",
      "greetings": [
        {
          "text": "Thornford lies east. Wolf Hollow is south. Follow its eastern path to rejoin the watch road; you do not need to cut through the thickets."
        }
      ],
      "topics": [],
      "nodes": []
    }
