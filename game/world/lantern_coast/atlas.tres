metadata/footpaths = [{"id": "millpond", "name": "Millpond Walk", "kind": "landmark", "note": "The old millrace fed three farms. Its stones still carry the marks of their households.", "at": [-755, 141], "points": [[-747, 183], [-756, 183], [-763, 181], [-764, 176], [-763, 166], [-762, 156], [-755, 141], [-736, 140], [-722, 146], [-719, 159], [-718.6, 162.3]], "heights": [null, 4, 4, 4, 4.1, 4.2, 4.6, 4.2, 4.1, 4.1, null], "paint_width": 1.44}, {"id": "watchers_knoll", "name": "Watcher's Knoll", "kind": "secret", "note": "The old coast guard kept a lantern on this ridge. Below it, the cart road winds east toward Bellharbor.", "at": [-702, 117], "points": [[-721, 164], [-728, 153], [-726, 145], [-717, 139], [-708, 137], [-697, 133], [-692, 125], [-697, 118], [-702, 117], [-706, 109], [-696, 106], [-686, 112], [-680, 124], [-679, 137], [-682, 144]], "heights": [null, 4.2, 4.6, 5.1, 5.8, 7.0, 8.6, 9.7, 10.4, 10.4, 9.9, 8.6, 6.8, 4.8, null], "paint": 0.94, "trailhead": {"label": "Watcher’s Knoll", "post": [-724, 163]}, "paint_width": 1.55}, {"id": "bell_barrows", "name": "The Bell Barrows", "kind": "secret", "note": "The hill keeps its bell long after the road forgot the name of the king buried here.", "at": [-665, -120], "points": [[-642, -151], [-653, -151], [-662, -147], [-669, -137], [-667, -126], [-665, -120], [-655, -113], [-645, -113], [-637, -117], [-630, -113], [-625, -108], [-619, -104], [-612, -103]], "heights": [null, 8.1, 8.3, 8.6, 9.5, 10.0, 9.2, 8.8, 8.6, 8.3, 8.0, 7.8, null], "paint_width": 1.05, "paint": 0.81}, {"id": "coppervein", "name": "Coppervein Mine", "kind": "dungeon", "note": "A blocked mining entrance. Fresh lamp soot stains the wood under the lintel.", "at": [-372, -217], "points": [[-365, -189], [-377, -200], [-372, -217]], "heights": [null, 19.4, 20.6]}, {"id": "sluice_keeper", "name": "Sluicekeeper's Walk", "kind": "secret", "note": "The old flood marks cut into the stone tell a different story to the names in the harbor ledger.", "at": [-300, 151], "points": [[-324, 167], [-311, 162], [-300, 151], [-291, 146]], "heights": [null, 4.4, 4.8, null]}, {"id": "webbed_deep", "name": "Webbed Deep", "kind": "dungeon", "note": "The pass watch used to patrol this cleft. The lantern hooks are still there.", "at": [-140, -32], "points": [[-119, -13], [-130, -21], [-140, -32]], "heights": [null, 31.0, 32.2]}, {"id": "vigil_crypt", "name": "Vigil Crypt", "kind": "dungeon", "note": "The last knights of Ashcourt asked to be buried with their watch bells.", "at": [123, -236], "points": [[104, -212], [118, -219], [123, -236]], "heights": [null, 15.3, 16.0]}, {"id": "rimewatch", "name": "Rimewatch Reliquary", "kind": "dungeon", "note": "Wax drips down the frozen threshold. Someone still tends a light in the snow.", "at": [445, -351], "points": [[456, -320], [451, -324], [446, -329], [443, -336], [445, -351]], "heights": [58, 58, 58.05, 58.5, 59.1], "shelf": 6.0}, {"id": "redwash_robbers", "name": "Siltjack Camp", "kind": "secret", "note": "The Siltjacks used to guide caravans through the wash. These days they still know exactly where to meet them.", "at": [380, 135], "points": [[337, 136], [353, 131], [365, 133], [380, 135], [397, 142], [400.8, 165]], "heights": [null, 8.8, 9.1, 9.1, 8.9, null]}, {"id": "sluice_pond", "name": "Sluicekeeper's Pond", "kind": "landmark", "note": "Water from the old sluice backs up into a quiet pool beside the village.", "at": [-296, 186], "points": [[-324, 169], [-311, 178], [-303, 181], [-296, 186]], "heights": [null, 4.5, 3.0, 1.7], "paint": 0.76}, {"id": "heron_oxbow", "name": "Heron Oxbow", "kind": "landmark", "note": "The sluice runs past an old reed bed. Fish shelter here when the current is strong.", "at": [-390, 78], "points": [[-420, 68], [-408, 73], [-400, 75], [-391, 79], [-390, 78]], "heights": [null, 4.5, 3.6, 2.05, 1.7], "paint": 0.81, "paint_width": 1.15}, {"id": "bracken_falls", "name": "Bracken Falls", "kind": "landmark", "note": "A cold spring breaks out of the ridge and feeds the Reedmire sluice all the way to the sea.", "at": [-357, 64], "points": [[-434, 44], [-421, 49], [-409, 54], [-397, 60], [-388, 58], [-378, 50], [-370, 52], [-365, 58], [-357, 64]], "heights": [null, 5.1, 4.9, 4.8, 4.5, 4.0, 3.7, 3.2, 1.7], "paint": 0.76}, {"id": "cutlass_cove", "name": "Cutlass Cove", "kind": "dock", "note": "The Saltglass crews trade under white sails. Red canvas marks the harbor where they unload the rest.", "at": [727, 299], "points": [[724, 245], [714, 262], [710, 277], [712, 289], [727, 299], [727, 300]], "heights": [null, 5.6, 4.6, 3.3, 2.25, 2.05], "paint": 0.75, "paint_width": 1.15}, {"id": "smugglers_cut", "name": "Smuggler's Cut", "kind": "secret", "note": "A dune track returns to Saltglass above the cove. The old signal post still faces the anchorage.", "at": [748, 277], "points": [[727, 300], [744, 292], [748, 277], [746, 260], [733, 248]], "heights": [2.25, 3.4, 6.2, 5.8, null], "paint": 0.72}, {"id": "iron_shelf", "name": "Signalman's Shelf", "kind": "secret", "note": "The lower road and its three watch lights are visible from the old signal perch.", "at": [-56, -91], "points": [[-76, -32], [-82, -45], [-80, -57], [-71, -72], [-62, -81], [-56, -91]], "heights": [null, 32, 34.5, 37, 39, 40], "paint": 0.94, "paint_width": 1.55, "trailhead": {"label": "Signalman’s Shelf", "post": [-73, -34]}}, {"id": "west_snowfields", "name": "Shepherd's White", "kind": "secret", "note": "In a good winter the sheep came back on their own. Nobody here remembers a good winter.", "at": [350, -307], "points": [[452, -317], [431, -303], [408, -308], [391, -322], [369, -319], [350, -307]], "heights": [null, 57, 55, 53, 51, 50], "paint": 0.78, "paint_width": 1.08}, {"id": "whitehorn_cirque", "name": "Goat Stair", "kind": "secret", "note": "The old goat track rises to a saddle where the east wind can cross the mountain.", "at": [551, -322], "points": [[462, -318], [480, -324], [498, -339], [519, -345], [537, -337], [551, -322]], "heights": [null, 57, 58, 61, 64, 65], "paint": 0.94, "paint_width": 1.55, "trailhead": {"label": "Goat Stair", "post": [462, -314]}}, {"id": "dry_wells", "name": "The Dry Wells", "kind": "landmark", "note": "Three wells follow the old caravan road. Only the western one ever ran dry before the sea changed course.", "at": [631, 268], "points": [[719, 244], [701, 240], [685, 250], [672, 266], [652, 274], [631, 268]], "heights": [null, 7.2, 7.6, 8, 9, 10], "paint": 0.78, "paint_width": 1.08}, {"id": "sailcloth_dunes", "name": "Sailcloth Dunes", "kind": "secret", "note": "When the wind lifts the sand, old mooring stones appear far inland.", "at": [817, 230], "points": [[741, 223], [763, 219], [777, 228], [789, 243], [804, 245], [817, 230]], "heights": [null, 7.5, 9, 11, 13, 13], "paint": 0.78, "paint_width": 1.08}, {"id": "veilwood", "name": "Veilwood Hollow", "kind": "secret", "note": "The green lights gather at the stones when the last of the daylight goes.", "at": [193, -171], "points": [[125, -190], [131, -175], [146, -166], [162, -170], [181, -178], [193, -171]], "heights": [null, 15.7, 15.2, 14.9, 15.6, 16], "paint": 0.78, "paint_width": 1.08}, {"id": "flint_overlook", "name": "Old Quarry Road", "kind": "landmark", "note": "Wardens once rang the quarry bell when a loaded wagon started down. Across the hollow you can still see their stone cutting.", "at": [-468, -251], "points": [[-365, -189], [-382, -198], [-395, -207], [-393, -220], [-401, -234], [-414, -238], [-429, -237], [-442, -244], [-452, -253], [-468, -251]], "heights": [null, 20, 23, 28, 34, 39, 43, 46, 48, 49], "paint_width": 1.55, "paint": 0.94, "shelf": 6.0, "trailhead": {"label": "Quarry Rim", "post": [-366, -185]}}, {"id": "flint_cave", "name": "Stonecutters' Way", "kind": "secret", "note": "The road builders cut through this saddle by lantern light. Names still show on the timber where their tools rested.", "at": [-462, -224], "points": [[-429, -237], [-439, -224], [-450, -224], [-462, -224], [-475, -224], [-483, -233], [-482, -244], [-468, -251]], "heights": [43, 44, 45.5, 45.5, 45.5, 46.5, 48, 49], "paint_width": 0.97, "paint": 0.81, "shelf": 4.2}, {"id": "white_summit", "name": "Whitehorn High Shelf", "kind": "landmark", "note": "Old cairns mark the upper shelf. In clear weather the pass looks like a single thread below.", "at": [510, -423], "points": [[445, -348], [428, -348], [414, -351], [400, -358], [393, -368], [405, -379], [423, -383], [439, -380], [453, -381], [455, -392], [448, -405], [455, -415], [469, -415], [481, -409], [495, -420], [510, -423]], "heights": [null, 58.5, 61, 65, 70, 76, 84, 91, 96, 100, 105, 109, 111, 113, 116, 118], "paint_width": 1.55, "paint": 0.94, "shelf": 6.0, "trailhead": {"label": "Whitehorn High Shelf", "post": [445, -344]}}, {"id": "white_cairns", "name": "Three Cairns of Whitehorn", "kind": "secret", "note": "Someone keeps leaving a blue ribbon here. The wind has only managed to steal two of them.", "at": [510, -423], "points": [[481, -409], [475, -395], [489, -388], [503, -390], [515, -397], [522, -408], [518, -416], [510, -423]], "heights": [113, 113, 114, 115, 116, 117, 118, 118], "paint_width": 0.87, "paint": 0.81, "shelf": 4.2}, {"id": "salt_bluff", "name": "Saltglass Bluff", "kind": "landmark", "note": "The first salt carriers marked shoals from here. When the mist lifts you can see which side of the headland they favoured.", "at": [846, 140], "points": [[817, 230], [829, 229], [840, 222], [848, 207], [850, 191], [843, 181], [839, 169], [842, 153], [846, 140]], "heights": [null, 13, 14, 17, 23, 27.7, 30, 33, 35], "paint_width": 1.55, "paint": 0.94, "shelf": 6.1, "trailhead": {"label": "Saltglass Bluff", "post": [816, 233]}}, {"id": "salt_cairn", "name": "The Tide Ledger", "kind": "secret", "note": "Four lines carved into a stone record the highest tides remembered by the old harbour master.", "at": [866, 155], "points": [[839, 169], [852, 165], [861, 160], [866, 155]], "heights": [30, 31, 32, 33], "paint_width": 0.88, "paint": 0.81, "shelf": 3.0}]
